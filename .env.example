# Copie para .env (que está no .gitignore) e ajuste. Valores abaixo servem só para desenvolvimento.

# Conexão com o PostgreSQL do docker-compose
DATABASE_URL=postgresql+asyncpg://estoque_user:estoque_pass@localhost:5432/estoque_db

# Chave de assinatura do JWT. Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-uma-chave-aleatoria-com-mais-de-32-caracteres

# Validade do token, em minutos (480 = 8h)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Gestor criado automaticamente na primeira execução (só se não houver nenhum usuário)
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@estoque.local
ADMIN_SENHA=troque-esta-senha
